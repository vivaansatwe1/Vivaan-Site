const themeToggle = document.getElementById('theme-toggle');

// Check if a theme preference was saved previously
const currentTheme = localStorage.getItem('theme');
if (currentTheme) {
  document.documentElement.setAttribute('data-theme', currentTheme);
  // Update emoji icon based on saved theme
  themeToggle.textContent = currentTheme === 'dark' ? '☀️' : '🌙';
}

// Listen for a click on the toggle button
themeToggle.addEventListener('click', () => {
  let theme = document.documentElement.getAttribute('data-theme');
  
  if (theme === 'dark') {
    document.documentElement.setAttribute('data-theme', 'light');
    localStorage.setItem('theme', 'light');
    themeToggle.textContent = '🌙'; // Moon emoji for light mode
  } else {
    document.documentElement.setAttribute('data-theme', 'dark');
    localStorage.setItem('theme', 'dark');
    themeToggle.textContent = '☀️'; // Sun emoji for dark mode
  }
});
