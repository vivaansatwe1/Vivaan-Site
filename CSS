/* Color variables for smooth theme switching */
:root {
  --bg-color: #f4f6f9;
  --card-bg: #ffffff;
  --text-main: #1e293b;
  --text-sub: #64748b;
  --btn-bg: #f1f5f9;
  --btn-text: #0f172a;
  --btn-hover-bg: #e2e8f0;
  --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.05);
}

[data-theme="dark"] {
  --bg-color: #0f172a;
  --card-bg: #1e293b;
  --text-main: #f8fafc;
  --text-sub: #94a3b8;
  --btn-bg: #334155;
  --btn-text: #f8fafc;
  --btn-hover-bg: #475569;
  --shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.3);
}

/* Base Styles */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Inter', sans-serif;
  background-color: var(--bg-color);
  color: var(--text-main);
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 20px;
  transition: background-color 0.3s ease;
}

/* Card Container */
.card {
  background-color: var(--card-bg);
  padding: 40px 30px;
  border-radius: 24px;
  width: 100%;
  max-width: 400px;
  text-align: center;
  box-shadow: var(--shadow);
  position: relative;
  transition: background-color 0.3s ease, box-shadow 0.3s ease;
}

/* Theme Toggle Button */
.theme-toggle {
  position: absolute;
  top: 20px;
  right: 20px;
  background: transparent;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  padding: 5px;
  border-radius: 50%;
  transition: transform 0.2s ease;
}

.theme-toggle:hover {
  transform: scale(1.1);
}

/* Profile Section */
.profile-image {
  width: 100px;
  height: 100px;
  background-color: var(--btn-hover-bg);
  background-image: url('https://via.placeholder.com/100');
  background-size: cover;
  background-position: center;
  border-radius: 50%;
  margin: 0 auto 20px auto;
  border: 3px solid var(--card-bg);
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
}

h1 {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 8px;
}

.subtitle {
  font-size: 0.95rem;
  color: var(--text-sub);
  margin-bottom: 30px;
  font-weight: 500;
}

/* Links Container & Buttons */
.links {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.link-btn {
  display: block;
  background-color: var(--btn-bg);
  color: var(--btn-text);
  text-decoration: none;
  padding: 16px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 1rem;
  transition: all 0.2s ease-in-out;
}

/* Smooth hover animations */
.link-btn:hover {
  background-color: var(--btn-hover-bg);
  transform: translateY(-2px);
}

.link-btn:active {
  transform: translateY(0);
}
